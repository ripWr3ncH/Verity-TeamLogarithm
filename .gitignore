# ==========================================================================
#  VERITY — .gitignore
#
#  Committed BEFORE the first `npm install`. If node_modules/ or generated
#  crypto material ever lands in history, it stays there forever and every
#  clone carries it. Do not relax these rules without asking the team.
# ==========================================================================

# --- Regenerated by tooling -----------------------------------------------
node_modules/
.next/
dist/
build/
out/
coverage/
*.tsbuildinfo
.turbo/

# --- Generated crypto material — regenerated by network.sh, AND SECRET -----
network/organizations/peerOrganizations/
network/organizations/ordererOrganizations/
network/organizations/fabric-ca/*/
!network/organizations/fabric-ca/*/fabric-ca-server-config.yaml
**/msp/keystore/
*.pem
*.key
!**/*.example.pem

# --- Runtime state — regenerated by up.sh and seed --------------------------
network/channel-artifacts/
network/system-genesis-block/
*.block
*.tx
*.tar.gz
ledger-snapshots/
pgdata/
logs/
*.log

# --- Fabric tooling downloaded by bootstrap.sh -----------------------------
network/bin/
network/builders/
config/

# --- Large media — link to these, never commit them ------------------------
*.mp4
*.mov
*.avi

# --- Local environment -----------------------------------------------------
.env
.env.*
!.env.example

# --- Editor / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
