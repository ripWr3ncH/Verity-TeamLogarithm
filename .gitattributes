# ==========================================================================
#  VERITY — line endings
#
#  The repo is authored on Windows and RUN INSIDE WSL2 / Linux containers.
#  Without this file, Git checks shell scripts out with CRLF endings and every
#  one of them fails with:
#
#      bash: ./network.sh: /usr/bin/env: bad interpreter: No such file or directory
#
#  which reads like a missing binary rather than a line-ending problem and
#  costs an hour to diagnose. The same applies to anything the Docker build
#  copies in.
#
#  Everything text is normalised to LF in the repository and checked out as LF.
# ==========================================================================

* text=auto eol=lf

# Executed by bash inside WSL2 and containers — LF is not optional here.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# Read by Linux tooling: configtxgen, cryptogen, docker compose, psql, Fabric CA.
*.yaml      text eol=lf
*.yml       text eol=lf
*.sql       text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.md        text eol=lf

# Binary — never touch these.
*.png       binary
*.jpg       binary
*.pdf       binary
*.mp4       binary
*.tar.gz    binary
*.block     binary
